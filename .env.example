# Definir versiones explícitas garantiza entornos reproducibles en Docker Compose y configurador.
MONGO_VERSION=8.0
PYTHON_VERSION=3.12

# Definir credenciales locales obligatorias sin valores implícitos en docker-compose.yml.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_me_local_only

# Especificar origen remoto y nombre local del archivo .archive maestro.
MONGO_SAMPLE_URL=https://atlas-education.s3.amazonaws.com/sampledata.archive
ARCHIVE_FILENAME=sampledata.archive

# Configurar enlace de red local únicamente en loopback por seguridad académica.
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
